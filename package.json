{
  "name": "harness-agent-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, open-source DeepSeek Harness plugins: an agent time machine (file checkpoints + safe restore) and a context operating system (context accounting, layered memory, retrieval).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b packages/shared packages/time-machine packages/context-os",
    "clean": "tsc -b --clean packages/shared packages/time-machine packages/context-os",
    "typecheck": "tsc -b packages/shared packages/time-machine packages/context-os --verbose",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "bench": "node benchmarks/run-all.ts",
    "bench:scale": "node benchmarks/bench-scale.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0"
  }
}
